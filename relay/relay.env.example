# HopDrop relay 环境变量样例
#
# 生产位置：/etc/relay/relay.env，权限必须是 0600 root:root
# （里面有主人链接与会话密钥的派生素材，泄露等于泄露入口）。
#
# 对照方案 v1.4 第 14.4 节。本地开发只需 RELAY_DATA_DIR 一项。

# 监听地址。服务只监听回环，对外由 Caddy 反代。
RELAY_ADDR=127.0.0.1:8080

# 对外域名，给 deploy/Caddyfile 用（由 install.sh 通过 systemd drop-in 注入
# Caddy 进程）。**留空时 Caddy 会降级为纯 HTTP（监听 :80）**，只够做部署验收：
# 此时 HTTPS 不可用，而浏览器会直接丢弃带 Secure 的会话 Cookie，表现是
# "首页能打开、配对却总是回到未登录"。
#
# 填域名后 Caddy 会自动申请并续期证书，前置条件是 80/443 公网可达且域名已解析。
# 备案未完成时 80 端口会被拦截，证书签不下来——所以备案要先于域名生效。
RELAY_DOMAIN=

# 数据目录。首次部署前先确认挂载点与剩余空间（方案 7.1）。
RELAY_DATA_DIR=/var/lib/relay

# 单文件上限。上限由 DDL 的 CHECK 约束锁死在 20 MiB，调大无效。
RELAY_MAX_FILE_BYTES=20971520

# 文件寿命与归档期
RELAY_FILE_TTL_DAYS=7
RELAY_ARCHIVE_TTL_DAYS=90

# 配额（方案 7.1 的"预留 + 上限"模型，不要改成系统盘百分比）
# 系统盘可用 6 GB、同机有共存服务，所以：预留 3 GB，relay 自己最多用 3 GB。
RELAY_ROOM_FILE_QUOTA_GB=2
RELAY_DISK_RESERVE_GB=3
RELAY_DATA_QUOTA_GB=3

# 访客码有效期（分钟）
RELAY_GUEST_TTL_MIN=120

# 会话 Cookie 是否带 Secure 属性。
# 生产必须保持 1（默认值）：Cookie 只在 HTTPS 上传输。
# 本地 http://127.0.0.1 开发时必须设为 0，否则浏览器会丢弃这个 Cookie，
# 表现是"配对成功但刷新后又变成未配对"。
# 关闭时会打一条 warning，不会阻止启动。
#
# 与 RELAY_DOMAIN 的联动：域名没配时 Caddy 走纯 HTTP，这项也必须临时设 0，
# 否则一样装不上 Cookie。这是"只做部署验收"的模式，验收完要两项一起补上。
RELAY_COOKIE_SECURE=1

# 以下为非方案内显式参数，取默认值即可，需要时再调。

# 清理任务间隔（秒）
RELAY_CLEANUP_INTERVAL_SEC=3600

# 快照里每个区域返回的最近消息条数
RELAY_SNAPSHOT_NOTE_LIMIT=100

# 分页
RELAY_PAGE_SIZE_DEFAULT=50
RELAY_PAGE_SIZE_MAX=200

# 单条文本上限（字节）与单区域活动消息上限
RELAY_NOTE_MAX_BYTES=65536
RELAY_BOARD_NOTE_LIMIT=20000

# WebSocket 连接上限与空闲超时（方案 10）。
# 连接表是进程内的内存态，所以调大这些值只影响本进程；uvicorn 也不能开多 worker。
# 空闲超时的依据是客户端每 25 秒发一次 ping，60 秒收不到活动即认为对端已消失。
RELAY_WS_ROOM_LIMIT=20
RELAY_WS_IP_LIMIT=10
RELAY_WS_IDLE_TIMEOUT_SEC=60

# 首页展示的备案号与违规内容举报联系方式（方案 11.1 / 第 13 节）。
#
# 这两项**必须由部署者填写**，代码里没有任何合理默认值：备案号是监管信息，
# 写一个编造的比不写严重得多。留空时首页不渲染对应那一段（而不是渲染一个
# 空占位），启动日志里会各打一条 warning，install.sh 也会提醒。
#
# 形如：RELAY_ICP_LICENSE=沪ICP备12345678号-1
RELAY_ICP_LICENSE=
RELAY_CONTACT=
