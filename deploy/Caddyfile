# HopDrop 反向代理配置（方案 14.3）
#
# 域名从环境变量 RELAY_DOMAIN 读，由 deploy/install.sh 通过 systemd drop-in
# 把 /etc/relay/relay.env 注入 Caddy 进程。**本文件因此不含任何部署专属信息**，
# 可以随每次发布被安全地整体覆盖——一旦把域名写死在这里，就再也不能自动更新它了。
#
# 证书由 Caddy 自动申请与续期，前置条件是 80 / 443 可从公网访问、
# 且域名解析已指向本机。备案未完成时 80 端口会被拦截，证书签不下来。
#
# 站点地址写成 {$RELAY_DOMAIN::80}：默认值是 :80，即域名没配时降级为纯 HTTP。
# 注意这是 {$VAR:默认值} 语法，而默认值本身以冒号开头，所以看起来像两个冒号
# ——不是笔误。给一个像 relay.example.com 这样的占位默认值的后果是：Caddy 会
# 拿它去反复申请证书，签不下来就重试，日志被刷满，而真正的问题（域名没配）
# 一条都不提。
#
# 纯 HTTP 模式下带 Secure 的会话 Cookie 会被浏览器丢弃，也就是"能打开页面但
# 配不上对"。这个模式只用于部署验收，生产必须配 RELAY_DOMAIN。
{$RELAY_DOMAIN::80} {
	encode zstd gzip

	header {
		# ⚠️ 这一组与 relay/app/security_headers.py 的 SECURITY_HEADERS 必须
		# 逐字一致。应用中间件也下一份（本地开发没有 Caddy，那时只有应用这
		# 一份在起作用），两处都留是为了应用挂掉返回 502 时头仍在。
		# tests/test_security_headers.py 会解析本文件逐条比对，改一处不改
		# 另一处会让测试失败——不要靠注释维持一致。
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy 127.0.0.1:8080

	# 25 MB 是单请求兜底，实际单文件上限由应用按 20 MiB 校验。
	request_body {
		max_size 25MB
	}

	# 访问日志默认关闭：URL 里会带房间与区域标识。
	# 需要排查时再临时打开，并注意日志脱敏。
	log {
		output discard
	}
}
