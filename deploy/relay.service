# HopDrop 中转服务（方案 14.4）
#
# 安装：cp deploy/relay.service /etc/systemd/system/relay.service
#       systemctl daemon-reload && systemctl enable --now relay
#
# 绝对不要加 --workers。方案 2.2 第 1 条：多 worker 会把 WebSocket 连接表
# 和全局写锁分裂成多份，一致性直接失效，而且症状很隐蔽。

[Unit]
Description=HopDrop cross-device relay service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/relay
EnvironmentFile=/etc/relay/relay.env
# ProtectSystem=strict 让 /opt/relay 只读，Python 写不了 __pycache__。
# 不加这条不会报错——Python 会静默跳过缓存写入，每次启动重新编译一遍源码；
# 加了省掉这次无用功，也让"为什么线上没有 .pyc"不再是个需要查的疑问。
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/relay/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8080 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/relay

[Install]
WantedBy=multi-user.target
